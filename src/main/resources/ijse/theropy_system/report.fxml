<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600"
            prefWidth="900"
            stylesheets="@css/report.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ijse.theropy_system.controller.ReportController">

    <children>

        <!-- Page Title -->
        <Label layoutX="20"
               layoutY="15"
               styleClass="page-title"
               text="Reporting " />

        <!-- Top Statistics -->
        <HBox layoutX="20"
              layoutY="60"
              spacing="20">

            <!-- Total Sessions -->
            <VBox prefHeight="100"
                  prefWidth="180"
                  styleClass="stat-card">

                <Label text="Total Sessions"
                       styleClass="card-title" />

                <Label fx:id="lblSessions"
                       text="120"
                       styleClass="card-value" />

            </VBox>

            <!-- Therapist Performance -->
            <VBox fx:id="adminCard"
                  prefHeight="100"
                  prefWidth="180"
                  styleClass="stat-card">

                <Label text="Top Therapist"
                       styleClass="card-title" />

                <Label fx:id="lblTherapist"
                       text="Dr. Silva"
                       styleClass="card-value" />

            </VBox>

            <!-- Revenue -->
            <VBox fx:id="financeCard"
                  prefHeight="100"
                  prefWidth="180"
                  styleClass="stat-card">

                <Label text="Monthly Revenue"
                       styleClass="card-title" />

                <Label fx:id="lblRevenue"
                       text="Rs. 250000"
                       styleClass="card-value" />

            </VBox>

        </HBox>

        <!-- Filter Section -->
        <HBox layoutX="20"
              layoutY="190"
              spacing="10">

            <ComboBox fx:id="cmbReportType"
                      prefWidth="180"
                      promptText="Select Report Type"
                      styleClass="input-field" />

            <DatePicker fx:id="dpFrom"
                        prefWidth="150"
                        promptText="From Date"
                        styleClass="input-field" />

            <DatePicker fx:id="dpTo"
                        prefWidth="150"
                        promptText="To Date"
                        styleClass="input-field" />

            <Button fx:id="btnGenerate"
                    text="Generate Report"
                    styleClass="btn-generate" />

        </HBox>

        <!-- Chart Section -->
        <BarChart fx:id="reportChart"
                  layoutX="20"
                  layoutY="250"
                  prefHeight="220"
                  prefWidth="420"
                  styleClass="chart">

            <xAxis>
                <CategoryAxis label="Category"/>
            </xAxis>

            <yAxis>
                <NumberAxis label="Value"/>
            </yAxis>

        </BarChart>

        <!-- Therapy History Table -->
        <TableView fx:id="tblHistory"
                   layoutX="460"
                   layoutY="250"
                   prefHeight="300"
                   prefWidth="420"
                   styleClass="table-view">

            <columns>

                <TableColumn prefWidth="90"
                             text="Patient ID" />

                <TableColumn prefWidth="130"
                             text="Patient Name" />

                <TableColumn prefWidth="120"
                             text="Program" />

                <TableColumn prefWidth="120"
                             text="Session Date" />

                <TableColumn prefWidth="140"
                             text="Therapist" />

            </columns>

        </TableView>

    </children>

</AnchorPane>