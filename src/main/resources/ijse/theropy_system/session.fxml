<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600"
            prefWidth="900"
            stylesheets="@css/session.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ijse.theropy_system.controller.SessionController">

    <children>

        <!-- Title -->
        <Label layoutX="20"
               layoutY="15"
               styleClass="page-title"
               text="Therapy Session Management" />

        <!-- Form Section -->
        <VBox layoutX="20"
              layoutY="60"
              prefHeight="310"
              prefWidth="843"
              spacing="10"
              styleClass="form-card">

            <Label styleClass="section-title"
                   text="Session Details" />

            <!-- Two Column Layout -->
            <HBox prefWidth="813"
                  spacing="15">

                <!-- Left -->
                <VBox prefWidth="390"
                      spacing="10">

                    <TextField fx:id="txtSessionId"
                               promptText="Session ID"
                               styleClass="input-field" />

                    <ComboBox fx:id="cmbPatient"
                              prefWidth="390"
                              promptText="Select Patient"
                              styleClass="input-field" />

                    <ComboBox fx:id="cmbProgram"
                              prefWidth="390"
                              promptText="Select Therapy Program"
                              styleClass="input-field" />

                    <DatePicker fx:id="dpSessionDate"
                                prefWidth="390"
                                promptText="Session Date"
                                styleClass="input-field" />

                </VBox>

                <!-- Right -->
                <VBox prefWidth="390"
                      spacing="10">

                    <ComboBox fx:id="cmbTherapist"
                              prefWidth="390"
                              promptText="Assign Therapist"
                              styleClass="input-field" />

                    <ComboBox fx:id="cmbTimeSlot"
                              prefWidth="390"
                              promptText="Select Time Slot"
                              styleClass="input-field" />

                    <ComboBox fx:id="cmbStatus"
                              prefWidth="390"
                              promptText="Session Status"
                              styleClass="input-field" />

                    <TextField fx:id="txtRoom"
                               promptText="Room Number"
                               styleClass="input-field" />

                </VBox>

            </HBox>

            <!-- Notes -->
            <TextArea fx:id="txtNotes"
                      prefRowCount="3"
                      promptText="Session Notes"
                      styleClass="input-field" />

            <!-- Buttons -->
            <HBox spacing="10">

                <Button fx:id="btnBook"
                        styleClass="btn-save"
                        text="Book Session" />

                <Button fx:id="btnUpdate"
                        styleClass="btn-update"
                        text="Update" />

                <Button fx:id="btnDelete"
                        styleClass="btn-delete"
                        text="Cancel" />

            </HBox>

        </VBox>

        <!-- Table Section -->
        <TableView fx:id="tblSessions"
                   layoutX="20"
                   layoutY="400"
                   prefHeight="180"
                   prefWidth="856"
                   styleClass="table-view">

            <columns>

                <TableColumn prefWidth="90"
                             text="Session ID" />

                <TableColumn prefWidth="150"
                             text="Patient" />

                <TableColumn prefWidth="150"
                             text="Therapist" />

                <TableColumn prefWidth="150"
                             text="Program" />

                <TableColumn prefWidth="120"
                             text="Date" />

                <TableColumn prefWidth="120"
                             text="Time" />

                <TableColumn prefWidth="76"
                             text="Status" />

            </columns>

        </TableView>

    </children>

</AnchorPane>
