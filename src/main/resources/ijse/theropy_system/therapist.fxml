<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="900" stylesheets="@css/therapist.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ijse.theropy_system.controller.TherapistController">

    <children>

        <!-- Title -->
        <Label layoutX="20" layoutY="15" styleClass="page-title" text="Therapist Management" />

        <!-- Form Section -->
        <VBox layoutX="20" layoutY="60" prefHeight="300" prefWidth="843" spacing="10" styleClass="form-card">

            <Label styleClass="section-title" text="Therapist Details" />

            <!-- Top Fields -->
            <HBox prefWidth="813" spacing="15">

                <!-- Left -->
                <VBox prefWidth="390" spacing="10">

                    <TextField fx:id="txtTherapistId" promptText="Therapist ID" styleClass="input-field" />

                    <TextField fx:id="txtSpecialization" promptText="Specialization" styleClass="input-field" />

                    <DatePicker fx:id="dpSchedule" prefWidth="390" promptText="Schedule Date" styleClass="input-field" />

                </VBox>

                <!-- Right -->
                <VBox prefWidth="390" spacing="10">

                    <TextField fx:id="txtTherapistName" promptText="Therapist Name" styleClass="input-field" />

                    <ComboBox fx:id="cmbProgram" prefWidth="390" promptText="Assign Therapy Program" styleClass="input-field" />

                </VBox>

            </HBox>

            <!-- Notes -->
            <TextArea fx:id="txtNotes" prefRowCount="3" promptText="Notes / Therapist Details" styleClass="input-field" />

            <!-- Buttons -->
            <HBox spacing="10">

                <Button fx:id="btnSave" styleClass="btn-save" text="Save" />

                <Button fx:id="btnUpdate" styleClass="btn-update" text="Update" />

                <Button fx:id="btnDelete" styleClass="btn-delete" text="Delete" />

            </HBox>

        </VBox>

        <!-- Table Section -->
        <TableView fx:id="tblTherapists" layoutX="22" layoutY="390" prefHeight="180" prefWidth="856" styleClass="table-view">

            <columns>

                <TableColumn prefWidth="90" text="ID" />

                <TableColumn prefWidth="170" text="Name" />

                <TableColumn prefWidth="150" text="Specialization" />

                <TableColumn prefWidth="170" text="Assigned Program" />

                <TableColumn prefWidth="120" text="Availability" />

                <TableColumn prefWidth="150" text="Schedule Date" />

            </columns>

        </TableView>

    </children>

</AnchorPane>
