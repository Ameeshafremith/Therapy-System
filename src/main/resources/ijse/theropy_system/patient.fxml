<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="900" stylesheets="@css/patient.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ijse.theropy_system.controller.PatientController">

    <children>

        <!-- Title -->
        <Label layoutX="20" layoutY="15" styleClass="page-title" text="Patient Management" />

        <!-- Form Section -->
        <VBox layoutX="20" layoutY="60" prefHeight="230.0" prefWidth="843.0" spacing="10" styleClass="form-card">

            <Label styleClass="section-title" text="Patient Details" />
         <HBox prefHeight="20.0" prefWidth="813.0">
            <children>
               <VBox prefHeight="82.0" prefWidth="579.0">
                  <children>
                     <TextField fx:id="txtId" prefHeight="30.0" prefWidth="582.0" promptText="Patient ID" styleClass="input-field" />
                     <TextField fx:id="txtAge" promptText="Age" styleClass="input-field" />
                  </children>
               </VBox>
               <VBox layoutX="10.0" layoutY="10.0" prefHeight="82.0" prefWidth="598.0">
                  <children>
                     <TextField fx:id="txtName" prefWidth="416.0" promptText="Full Name" styleClass="input-field" />
                     <TextField fx:id="txtContact" promptText="Contact Number" styleClass="input-field" />
                  </children>
               </VBox>
            </children>
         </HBox>
         <TextArea fx:id="txtAddress" prefRowCount="3" promptText="Address" styleClass="input-field" />

            <HBox spacing="10">

                <Button fx:id="btnSave" styleClass="btn-save" text="Save" />

                <Button fx:id="btnUpdate" styleClass="btn-update" text="Update" />

                <Button fx:id="btnDelete" styleClass="btn-delete" text="Delete" />

            </HBox>

        </VBox>

        <!-- Table Section -->
        <TableView fx:id="tblPatients" layoutX="22.0" layoutY="300.0" prefHeight="269.0" prefWidth="856.0" styleClass="table-view">

            <columns>

                <TableColumn prefWidth="59.20001411437988" text="ID" />
                <TableColumn prefWidth="186.4000473022461" text="Name" />
                <TableColumn prefWidth="75.199951171875" text="Age" />
                <TableColumn prefWidth="166.4000244140625" text="Contact" />
                <TableColumn prefWidth="231.20004272460938" text="Address" />
            <TableColumn prefWidth="144.79998779296875" text="Registered Date" />

            </columns>

        </TableView>

    </children>

</AnchorPane>
